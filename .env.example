# =============================================================================
# Contact form email delivery (see app/api/contact/route.ts)
# =============================================================================
# Required — get an API key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional — override the destination inbox (defaults to SITE.email from lib/constants.ts)
CONTACT_TO=info@consulatng.net

# Optional — the "From" address. Must be verified on your Resend account.
# During development you can leave this unset and use Resend's shared sandbox
# sender (onboarding@resend.dev), which can only deliver to the email address
# that registered the Resend account.
# For production, verify a domain in Resend and set e.g.:
#   CONTACT_FROM=Consulat Website <no-reply@consulatng.net>
CONTACT_FROM=


# =============================================================================
# WordPress CMS (see lib/wp.ts and CMS_PLAYBOOK.md §4)
# =============================================================================
# LEAVE BLANK AND EVERYTHING STILL WORKS. With WP_API_URL unset, the site reads
# blog posts from content/blog/*.mdx and FAQs from lib/faqs.ts exactly as it did
# before the CMS was introduced. Set it to switch over; unset it to roll back
# without a code change.
#
# The REST root of the WordPress install — no trailing slash.
#   WP_API_URL=https://cms.consulatng.net/wp-json
WP_API_URL=

# Shared secret for on-demand revalidation. Must be identical to
# CONSULAT_REVALIDATE_SECRET in the WordPress wp-config.php, or publishing in
# WordPress will not update the live site.
# Generate one with:  openssl rand -hex 32
REVALIDATE_SECRET=

# WordPress Application Password, used only to fetch unpublished drafts for
# preview. Create at WP Admin → Users → Profile → Application Passwords.
# Never the account's real login password.
WP_APP_USER=
WP_APP_PASSWORD=
