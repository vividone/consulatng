# =============================================================================
# Contact form email delivery (see app/api/contact/route.ts)
# =============================================================================
# Required — get an API key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional — override the destination inbox (defaults to SITE.email from lib/constants.ts)
CONTACT_TO=info@consulatng.net

# Optional — the "From" address. Must be verified on your Resend account.
# During development you can leave this unset and use Resend's shared sandbox
# sender (onboarding@resend.dev), which can only deliver to the email address
# that registered the Resend account.
# For production, verify a domain in Resend and set e.g.:
#   CONTACT_FROM=Consulat Website <no-reply@consulatng.net>
CONTACT_FROM=
