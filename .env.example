# =============================================================================
# Contact form email delivery (see app/api/contact/route.ts)
# =============================================================================
# Required — get an API key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional — override the destination inbox (defaults to SITE.email from lib/constants.ts)
CONTACT_TO=info@consulatng.net

# Optional — the "From" address. Must be verified on your Resend account.
# During development you can leave this unset and use Resend's shared sandbox
# sender (onboarding@resend.dev), which can only deliver to the email address
# that registered the Resend account.
# For production, verify a domain in Resend and set e.g.:
#   CONTACT_FROM=Consulat Website <no-reply@consulatng.net>
CONTACT_FROM=


# =============================================================================
# Payload CMS + operations platform (see payload.config.ts)
# =============================================================================
# Postgres connection string. Locally this is the embedded server started by
# `npm run db:start`; in production it is the Railway Postgres URL.
#
# NOTE: Vercel serverless opens a connection per invocation and Railway ships
# no managed pooler. Point this at PgBouncer, not at Postgres directly, before
# this sees real traffic. See db/README.md.
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:54329/consulat

# Signs Payload's auth tokens. Generate with:  openssl rand -hex 32
# Changing it logs every admin user out.
PAYLOAD_SECRET=

# Optional — overrides the "From" address on Payload's password-reset emails.
PAYLOAD_FROM_ADDRESS=no-reply@consulatng.net


# =============================================================================
# Media storage (S3-compatible)
# =============================================================================
# LEAVE BLANK LOCALLY. With S3_BUCKET unset, Payload writes uploads to
# public/uploads on local disk, which is what you want on a dev machine.
#
# REQUIRED IN PRODUCTION. Vercel's filesystem is read-only, so without these
# every upload fails on deploy — and only on deploy, which is the worst way
# to find out.
#
# Works against any S3-compatible server. For Railway-hosted storage, deploy
# Garage or SILO (MinIO's upstream was archived in April 2026) and use the
# bucket service's private or public domain as the endpoint.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The base URL browsers fetch media from, WITHOUT a trailing slash.
#
# Separate from S3_ENDPOINT, which is the API endpoint the server signs
# requests against. Set this when the public read host differs — which is not
# an edge case:
#
#   Tigris   https://<bucket>.t3.storageapi.dev
#            (path-style endpoint/bucket/<key> needs a signature and gives a
#            browser 403, which looks exactly like a bad ACL and is not)
#   CDN      https://media.consulatng.net
#
# Leave blank for AWS, Garage and most self-hosted servers, which serve
# path-style reads fine.
#
# Read at BUILD time by next.config.mjs for images.remotePatterns, so it must
# be set in the Vercel build environment, not only at runtime.
S3_PUBLIC_URL=

# Optional. Defaults to us-east-1 — self-hosted servers ignore it, but the
# AWS SDK requires some value.
S3_REGION=us-east-1

# Optional. Defaults to true (host/bucket/key), which self-hosted servers
# need. Set to "false" only for real AWS S3, which uses bucket subdomains.
S3_FORCE_PATH_STYLE=true
